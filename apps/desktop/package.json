{
  "name": "@modex/desktop",
  "version": "0.3.0",
  "description": "Modex desktop — a Codex-App-style GUI: projects, parallel agent threads, worktrees, inline approvals, and a live Changes panel.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "./dist/src/main/index.js",
  "scripts": {
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json && cp src/main/preload.cjs dist/src/main/preload.cjs",
    "build:renderer": "vite build",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "test": "npm run build:main && node --test \"dist/test/**/*.test.js\"",
    "start": "electron .",
    "dev": "vite",
    "screenshot": "electron . --demo --screenshot"
  },
  "dependencies": { "@modex/core": "0.3.0" },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.4.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^8.3.1"
  }
}
